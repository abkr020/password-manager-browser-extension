{
  "manifest_version": 3,
  "name": "Password Manager",
  "version": "0.0.0",
  "permissions": ["storage"],
  "action": {
    "default_title": "Password Manager",
    "default_popup": "index.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
